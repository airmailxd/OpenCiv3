{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 5000,
      "MaxConcurrentUpgradedConnections": 5000
    }
  },
  "Relay": {
    "MaxHostMessageBytes": 8388608,
    "MaxGuestMessageBytes": 262144,
    "MaxReceiveBufferBytes": 536870912,
    "MaxQueuedBytes": 67108864,
    "MaxRooms": 1000,
    "MaxGuestsPerRoom": 16,
    "MaxConnectionsPerAddress": 32,
    "MaxConnections": 2000,
    "RoomTtlSeconds": 600,
    "PingIntervalSeconds": 15,
    "IdleTimeoutSeconds": 45,
    "ConnectionsPerMinute": 120,
    "RoomsPerHour": 30,
    "FailedJoinsPerTenMinutes": 20,
    "KeySecret": "",
    "TrustForwardedHeaders": false
  }
}
