# Identify text-based files and standardize to Unix (lf) line endings

# Default: git detects text files and stores them with LF, so a checkout
# on Windows and one on Linux agree. The rules below override this.
* text=auto eol=lf

# C# files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Godot files
*.tscn text eol=lf
*.godot text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.gd text eol=lf
*.shader text eol=lf

# Other
*.md text eol=lf
*.ps1 text eol=lf

.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Super-long text files
C7/Text/c7-static-map-save.json binary
C7/Text/c7-static-map-save.json -diff
C7/Text/c7-static-map-save-standalone.json binary
C7/Text/c7-static-map-save-standalone.json -diff

# Windows batch files need CRLF for labels and goto
*.cmd text eol=crlf
