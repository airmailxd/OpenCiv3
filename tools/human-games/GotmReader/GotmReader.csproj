<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads Civ3 Conquests .SAV files (GOTM/COTM submissions) with QueryCiv3 and prints one JSON line per save:
       the human's cities, captures and territory at checkpoint turns from the save's replay (RPLS), and the
       final government and units. Never runs anything from the saves; they are only parsed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\QueryCiv3\QueryCiv3.csproj" />
  </ItemGroup>

</Project>
